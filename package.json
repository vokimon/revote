    "gh-pages": "^6.3.0",
    "material-components-web": "^0.44.1"
  },
  "dependencies": {
    "d3": "^5.7.0",
    "font-awesome": "^4.7.0",
    "i18n4v": "^0.2.2",
    "marked": "^18.1.2",
